# Ported from the upstream Mercurial repository's .hgignore.
tools/o3_tiny.hex
tools/crop_ostc3_hex_büro.bat
tools/o3pack_büro.bat
hwos.X*
src/Tests/build/

# Local sync tooling noise.
__pycache__/

# Site-specific Windows builder connection and checkout settings.
tools/build_hwos.remote.conf

# Local firmware build output (including the upload artefact).
build/

# Generated firmware images remain untracked. Upstream-supplied packaging tools
# and runtime DLLs at their original tools/ paths are tracked intentionally.
tools/*.hex
src/*.lib
